{
  "name": "@cloudcli-ai/cloudcli",
  "version": "1.37.0",
  "productName": "CloudCLI",
  "description": "A web-based UI for Claude Code CLI",
  "type": "module",
  "main": "dist-server/server/index.js",
  "bin": {
    "cloudcli": "dist-server/server/modules/cli/cli.js"
  },
  "files": [
    "electron/",
    "server/",
    "shared/",
    "public/api-docs.html",
    "dist/",
    "dist-server/",
    "scripts/",
    "README.md"
  ],
  "homepage": "https://cloudcli.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siteboon/claudecodeui.git"
  },
  "bugs": {
    "url": "https://github.com/siteboon/claudecodeui/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server:dev\" \"npm run client\"",
    "server": "node dist-server/server/index.js",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:dev-watch": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "client": "vite",
    "desktop": "electron electron/main.js",
    "desktop:dev": "cross-env ELECTRON_DEV_URL=http://127.0.0.1:5173 electron electron/main.js",
    "desktop:stage": "node scripts/release/prepare-desktop-app.js",
    "desktop:pack": "npm run build && npm run desktop:stage && electron-builder --projectDir .desktop-build/desktop-app --dir",
    "desktop:dist:mac": "npm run build && npm run desktop:stage && electron-builder --projectDir .desktop-build/desktop-app --mac dmg",
    "desktop:dist:win": "npm run build && npm run desktop:stage && electron-builder --projectDir .desktop-build/desktop-app --win nsis",
    "server:bundle": "npm run build && node scripts/release/build-server-bundle.js",
    "desktop:icon:mac": "node electron/scripts/generate-macos-icon.js",
    "build": "concurrently --kill-others-on-fail \"npm run build:client\" \"npm run build:server\"",
    "build:client": "cross-env NODE_ENV=production vite build --mode production && npm run validate:client-codemirror-chunks && npm run validate:client-bundle",
    "prebuild:server": "node scripts/validation/prepare-server-build.mjs",
    "build:server": "tsc -p server/tsconfig.json && tsc-alias -p server/tsconfig.json",
    "validate:nested-sessions": "node --import tsx scripts/validation/nested-session-smoke.mjs",
    "validate:opencode-session-reconciliation": "node scripts/validation/opencode-session-recovery-smoke.mjs",
    "validate:opencode-crash-diagnostics": "cross-env TSX_TSCONFIG_PATH=server/tsconfig.json node --import tsx scripts/validation/opencode-crash-diagnostics-smoke.mjs",
    "validate:realtime-hydration": "cross-env TSX_TSCONFIG_PATH=server/tsconfig.json node --import tsx scripts/validation/realtime-session-hydration-smoke.mjs",
    "validate:client-bundle": "node scripts/validation/client-bundle-budget.mjs",
    "validate:client-codemirror-chunks": "node scripts/validation/client-codemirror-chunks.mjs",
    "validate:service-worker-notifications": "node --test scripts/validation/service-worker-notifications.test.mjs",
    "preview": "vite preview",
    "typecheck": "concurrently --kill-others-on-fail \"npm run typecheck:frontend\" \"npm run typecheck:backend\"",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.json",
    "typecheck:backend": "tsc -p server/tsconfig.typecheck.json",
    "test": "node scripts/test-all.mjs",
    "test:backend": "cross-env TSX_TSCONFIG_PATH=server/tsconfig.json node --import tsx --test \"server/**/*.test.ts\" \"server/**/*.test.js\"",
    "test:backend:emitted": "node scripts/validation/run-backend-tests.mjs",
    "test:contracts": "node --import tsx --test \"shared/**/*.test.ts\"",
    "test:frontend": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"src/**/*.test.js\"",
    "test:frontend-contracts": "node --import tsx --test --test-isolation=none \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"src/**/*.test.js\" \"shared/**/*.test.ts\"",
    "test:frontend:critical": "npm run test:frontend",
    "test:e2e:stability": "playwright test e2e/realtime-hydration.spec.ts",
    "lint": "eslint --max-warnings 0 --cache --cache-strategy content --cache-location .eslintcache src/ server/",
    "lint:strict": "eslint --max-warnings 0 src/main.tsx src/utils/api.ts src/utils/apiClient.ts src/utils/authToken.ts src/contexts/ThemeContext.tsx src/contexts/WebSocketContext.tsx src/hooks/useLocalStorage.ts src/lib/serverState.ts src/stores/useSessionStore.ts",
    "validate:stability": "node scripts/test-all.mjs",
    "lint:fix": "eslint src/ server/ --fix",
    "start": "npm run build && npm run server",
    "release": "./release.sh",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/fix-node-pty.js",
    "prepare": "husky",
    "update:platform": "./update-platform.sh",
    "deps:check": "ncu --target latest",
    "deps:update": "ncu -u --target latest"
  },
  "build": {
    "appId": "ai.cloudcli.desktop",
    "productName": "CloudCLI",
    "asar": false,
    "artifactName": "cloudcli-desktop-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release/desktop"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "electron/",
      "public/",
      "dist/",
      "dist-server/",
      "shared/",
      "server/",
      "package.json",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-{darwin,linux,win32}-*/**"
    ],
    "protocols": [
      {
        "name": "CloudCLI",
        "schemes": [
          "cloudcli"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "electron/assets/logo-macos.icns",
      "notarize": true,
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "CFBundleName": "CloudCLI",
        "CFBundleDisplayName": "CloudCLI",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "CloudCLI",
            "CFBundleURLSchemes": [
              "cloudcli"
            ]
          }
        ]
      }
    },
    "win": {
      "icon": "electron/assets/logo-windows.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "electron/assets/logo-windows.ico",
      "uninstallerIcon": "electron/assets/logo-windows.ico"
    }
  },
  "keywords": [
    "claude code",
    "claude-code",
    "claude-code-ui",
    "cloudcli",
    "codex",
    "cursor",
    "cursor-cli",
    "anthropic",
    "openai",
    "google",
    "coding-agent",
    "web-ui",
    "ui",
    "mobile IDE"
  ],
  "author": "CloudCLI UI Contributors",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.224",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@iarna/toml": "^2.2.5",
    "@octokit/rest": "^22.0.1",
    "@openai/codex-sdk": "^0.147.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/react-codemirror": "^4.25.11",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.13",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "ignore": "^7.0.6",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.30.0",
    "mime-types": "^3.0.2",
    "multer": "^2.2.0",
    "node-pty": "^1.2.0-beta.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.0.0",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.62.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "auto-changelog": "^2.6.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "node-gyp": "^13.0.1",
    "npm-check-updates": "23.0.2",
    "postcss": "^8.5.26",
    "release-it": "^21.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": "eslint",
    "server/**/*.{js,ts}": "eslint"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "screenshot-desktop": "^1.15.4"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "node-pty@1.2.0-beta.15": true,
    "unrs-resolver@1.12.2": true
  }
}
